{
	"name": "@moca-labs/mock-kit-ts",
	"version": "0.1.0",
	"description": "Axios-Kit-ts 위에서 동작하는, 백엔드 없이 화면부터 만들기 위한 mock 라이브러리",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepublishOnly": "npm run build",
		"pretest": "tsc --noEmit -p tsconfig.test.json",
		"lint": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "vitest run",
		"demo": "npm --prefix demo install && npm --prefix demo run dev"
	},
	"keywords": [
		"mock",
		"axios",
		"typescript",
		"decorator",
		"moca-libs"
	],
	"author": "IDEa Team",
	"license": "Apache-2.0",
	"peerDependencies": {
		"@moca-labs/axios-kit-ts": ">=0.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@moca-labs/axios-kit-ts": "^0.6.2",
		"@moca-labs/entity-kit-ts": "^0.6.2",
		"@types/node": "^25.2.0",
		"axios": "^1.19.0",
		"jsdom": "^30.0.1",
		"typescript": "^6.0.3",
		"vitest": "^3.0.0"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moca-labs/Mock-Kit-ts.git"
	}
}
